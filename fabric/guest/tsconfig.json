{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,

    // Required by the Lit source imported from server/static/src.
    "experimentalDecorators": true,
    "useDefineForClassFields": false,

    // Follow the game-src links without resolving them, so a renderer's
    // `../../src/client.js` lands on this package's src/client.ts, and so the
    // client packages (file: dependencies, linked into node_modules) find
    // `lit` in this package's node_modules.
    "preserveSymlinks": true,
    "types": ["node"]
  },
  "include": ["protocol.ts", "src/**/*.ts", "tests/**/*.ts", "vite.config.ts", "vite.fabric.config.ts", "playwright.config.ts"]
}
