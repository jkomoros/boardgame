{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,

    // Required by the Lit source imported from server/static/src.
    "experimentalDecorators": true,
    "useDefineForClassFields": false,

    // Follow the game-src symlinks the way the webapp does, so a renderer's
    // `../../src/client.js` lands in server/static/src.
    "preserveSymlinks": true,
    "baseUrl": ".",
    "paths": {
      "@client/*": ["../../server/static/src/*"],
      "@game-src/*": ["../../server/static/game-src/*"],
      // The client source has no node_modules beside it in this checkout.
      "lit": ["./node_modules/lit/index.d.ts"],
      "lit/*": ["./node_modules/lit/*"],
      "reselect": ["./node_modules/reselect/lib/index.d.ts"]
    },
    "types": ["node"]
  },
  "include": ["protocol.ts", "src/**/*.ts", "tests/**/*.ts", "vite.config.ts", "playwright.config.ts"]
}
