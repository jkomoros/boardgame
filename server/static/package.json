{
  "name": "boardgame-webapp",
  "version": "0.1.0",
  "type": "module",
  "license": "BSD-3-Clause",
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@playwright/test": "^1.58.2",
    "@types/node": "^20.0.0",
    "lit-analyzer": "2.0.3",
    "typescript": "^5.3.0",
    "vite": "^6.0.0"
  },
  "scripts": {
    "audit:ci": "npm audit --audit-level=high",
    "audit:prod": "npm audit --omit=dev --audit-level=high",
    "dev": "vite",
    "build": "tsc && vite build",
    "type-check": "tsc --noEmit",
    "type-check:strict": "tsc --noEmit -p tsconfig.strict.json",
    "type-check:strict-migration": "tsc --noEmit -p tsconfig.strict-migration.json",
    "type-check:authoring": "node scripts/check-client.mjs --project tsconfig.authoring.json",
    "test:check-client": "node --test scripts/check-client.test.mjs",
    "test:unit": "node --test 'src/**/*.test.ts'",
    "test:facade-production": "node tests/renderer/facade-production.mjs",
    "test": "npm run test:e2e",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:headed": "HEADED=1 playwright test",
    "test:e2e:report": "playwright show-report",
    "test:renderer": "playwright test --config playwright.renderer.config.ts"
  },
  "dependencies": {
    "@material/web": "^2.2.0",
    "firebase": "^11.1.0",
    "lit": "^3.2.1",
    "pwa-helpers": "^0.9.1",
    "redux": "^5.0.1",
    "redux-thunk": "^3.1.0",
    "reselect-tools": "0.0.7"
  },
  "allowScripts": {
    "@firebase/util@1.12.1": true,
    "esbuild@0.25.12": true,
    "fsevents@2.3.2": true,
    "fsevents@2.3.3": true,
    "protobufjs@7.6.5": true
  }
}
